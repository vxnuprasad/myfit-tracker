# Copy this file to .env.local (local) and add the same names in Vercel > Project > Settings > Environment Variables.
# NEVER commit .env.local, and NEVER give any of the secret values below a NEXT_PUBLIC_ prefix.
# Comments are on their own lines on purpose: some tools do not strip trailing comments.

# SECRET. Fine-grained GitHub token. Repository access: ONLY your private data repo. Permission: Contents = Read and write.
GITHUB_TOKEN=

# Your PRIVATE data repository in owner/name form, e.g. your-username/myfit-data (not this source repo).
GITHUB_REPO=

# Branch in the data repo that holds the data. The branch must already exist (initialise the repo with a README).
GITHUB_BRANCH=main

# SECRET. A long, unique passphrase you choose. Enter it once in the app: Settings > Cloud Sync > App password.
# If this is empty, the /api/data route refuses every request.
APP_PASSWORD=

# OPTIONAL, PUBLIC (shown to every visitor). Identify yourself as the operator of an independent deployment.
# See docs/ATTRIBUTION_AND_FORKS.md. Leave unset on the original author's own deployment.
# NEXT_PUBLIC_OPERATOR_NAME=Your Name
# NEXT_PUBLIC_OPERATOR_URL=https://your-site.example
